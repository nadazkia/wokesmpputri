# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES WONDERKIND FESTIVAL
# Copy file ini menjadi .env lalu isi dengan kredensial Supabase Anda
# ==============================================================================

# 1. Supabase Credentials (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Nomor WhatsApp Resmi Panitia (Awali dengan kode negara 62 tanpa tanda + atau 0 di depan)
# Contoh: 62895622984364
REACT_APP_OFFICIAL_WHATSAPP=62895622984364
